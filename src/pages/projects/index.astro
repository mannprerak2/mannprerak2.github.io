---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';
import { Search, Code } from '@lucide/astro';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all unique tags
const allTags = Array.from(
  new Set(
    projects.flatMap(p => p.data.tags || [])
  )
).sort();
---

<Layout title="Projects | Prerak Mann" description="Explore open-source software, packages, and side projects built by Prerak Mann.">
  <div class="space-y-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto space-y-4">
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl tracking-tight text-zinc-900 dark:text-zinc-50">
        My <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-500 to-indigo-500">Projects</span>
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed text-sm sm:text-base">
        A collections of my side-projects, open-source packages, and things I've built. Use the filter chips or search bar below to find specific projects.
      </p>
    </div>

    <!-- Search & Filters Container -->
    <div class="max-w-4xl mx-auto space-y-6">
      <!-- Search Input -->
      <div class="relative max-w-md mx-auto">
        <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-zinc-400 dark:text-zinc-500">
          <Search class="w-5 h-5" />
        </span>
        <input 
          type="text" 
          id="project-search"
          placeholder="Search projects..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-brand-500/25 focus:border-brand-500 transition-all duration-150"
        />
      </div>

      <!-- Tag Filters -->
      <div class="flex flex-wrap items-center justify-center gap-2" id="tag-filters">
        <button 
          data-tag="all"
          class="filter-chip active-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-500 text-white transition-all duration-150"
        >
          All Projects
        </button>
        {allTags.map((tag) => (
          <button 
            data-tag={tag.toLowerCase()}
            class="filter-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600 dark:bg-zinc-800/60 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all duration-150"
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div 
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto" 
      id="projects-grid"
    >
      {sortedProjects.map((project) => {
        const titleLower = project.data.title.toLowerCase();
        const summaryLower = project.data.summary.toLowerCase();
        const tagsJoined = (project.data.tags || []).map(t => t.toLowerCase()).join(' ');

        return (
          <div 
            class="project-card-wrapper transition-all duration-300"
            data-title={titleLower}
            data-summary={summaryLower}
            data-tags={tagsJoined}
          >
            <Card 
              title={project.data.title.replace(' 🔗', '')}
              description={project.data.summary.replace('|', '').trim()}
              tags={project.data.tags}
              link={project.data.external_link}
              featured={project.data.featured}
              date={project.data.date}
            />
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-16 space-y-4 max-w-md mx-auto">
      <div class="w-12 h-12 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mx-auto text-zinc-400">
        <Code class="w-6 h-6" />
      </div>
      <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-lg">No projects found</h3>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Try adjusting your search terms or filter settings.
      </p>
    </div>
  </div>

  <!-- Client-side filter script -->
  <script>
    const searchInput = document.getElementById('project-search') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('.filter-chip');
    const projectCards = document.querySelectorAll('.project-card-wrapper');
    const emptyState = document.getElementById('empty-state');

    let activeTag = 'all';
    let searchQuery = '';

    function filterProjects() {
      let visibleCount = 0;

      projectCards.forEach((card) => {
        const el = card as HTMLElement;
        const title = el.dataset.title || '';
        const summary = el.dataset.summary || '';
        const tags = el.dataset.tags || '';

        const matchesSearch = title.includes(searchQuery) || summary.includes(searchQuery);
        const matchesTag = activeTag === 'all' || tags.split(' ').includes(activeTag);

        if (matchesSearch && matchesTag) {
          el.style.display = 'block';
          // Force a tiny reflow for fade in
          setTimeout(() => el.style.opacity = '1', 10);
          visibleCount++;
        } else {
          el.style.opacity = '0';
          el.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterProjects();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const tag = button.dataset.tag || 'all';

        // Update active chip classes
        filterButtons.forEach(b => {
          b.classList.remove('bg-brand-500', 'text-white', 'active-chip');
          b.classList.add('bg-zinc-100', 'text-zinc-600', 'dark:bg-zinc-800/60', 'dark:text-zinc-300');
        });

        button.classList.add('bg-brand-500', 'text-white', 'active-chip');
        button.classList.remove('bg-zinc-100', 'text-zinc-600', 'dark:bg-zinc-800/60', 'dark:text-zinc-300');

        activeTag = tag;
        filterProjects();
      });
    });
  </script>
</Layout>
