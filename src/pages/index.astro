---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';
import { Mail, FileText, ExternalLink, Award, Sparkles, Code, Briefcase, GraduationCap, Search } from '@lucide/astro';

const cv = yaml.load(fs.readFileSync(path.resolve('src/data/cv.yaml'), 'utf8')) as any;
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

import { parseMarkdown } from '../utils/markdown';
import { getTagStyles } from '../utils/colors';

const parsedBio = parseMarkdown(cv.bio);
---

<Layout>
  <!-- Hero Section -->
  <section class="py-12 md:py-20 flex flex-col-reverse md:flex-row items-center justify-between gap-10 border-b border-zinc-200/50 dark:border-zinc-800/50 transition-colors duration-200">
    <div class="flex-1 text-center md:text-left">
      
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        Hi, I'm <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-500 to-indigo-500">{cv.name}</span>
      </h1>
      
      <p class="font-display font-medium text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 mb-6">
        {cv.role}
      </p>

      <!-- Contact Icons -->
      <div class="flex flex-wrap justify-center md:justify-start gap-4">
        {cv.email && (
          <a href={`mailto:${cv.email}`} class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200 shadow-sm transition-all duration-200">
            <Mail class="w-4 h-4" />
            Contact Me
          </a>
        )}
        <a href={cv.resumeUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all duration-200">
          <FileText class="w-4 h-4" />
          View Resume
        </a>
      </div>

      <!-- Socials -->
      <div class="flex items-center justify-center md:justify-start gap-4 mt-8 text-zinc-500 dark:text-zinc-400">
        {cv.github && (
          <a href={cv.github} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
        )}
        {cv.linkedin && (
          <a href={cv.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        )}
      </div>
    </div>

    <!-- Avatar picture -->
    <div class="w-44 h-44 sm:w-56 sm:h-56 relative">
      <div class="relative w-full h-full rounded-full overflow-hidden border-4 border-zinc-200 dark:border-zinc-800 shadow-md">
        <img 
          src={cv.avatar} 
          alt={cv.name} 
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- About Me Section -->
  <section class="py-12 sm:py-16 border-b border-zinc-200/50 dark:border-zinc-800/50 max-w-3xl">
    <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-6">
      <Code class="w-6 h-6 text-brand-500" />
      About Me
    </h2>
    <div class="text-zinc-700 dark:text-zinc-300">
      <div set:html={parsedBio} class="prose prose-zinc dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed" />
      
      <!-- Skills chips list -->
      <div class="mt-8 space-y-4">
        <h3 class="font-bold text-zinc-950 dark:text-zinc-50 text-sm uppercase tracking-wider">
          Technical Arsenal
        </h3>
        <div class="space-y-3">
          {cv.skills.map((group: any) => (
            <div>
              <span class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block mb-1.5">
                {group.category}
              </span>
              <div class="flex flex-wrap gap-2">
                {group.items.map((skill: string) => (
                  <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold border transition-colors ${getTagStyles(skill)}`}>
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Experience Stacked -->
  <section class="py-12 sm:py-16 border-b border-zinc-200/50 dark:border-zinc-800/50">
    <div class="max-w-3xl space-y-12">
      <!-- Education -->
      <div>
        <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-8">
          <GraduationCap class="w-6 h-6 text-brand-500" />
          Education
        </h2>
        <Timeline items={cv.education.map((edu: any) => ({
          title: edu.course,
          subtitle: edu.institution,
          year: edu.year,
          details: edu.details,
          hideDuration: edu.hideDuration
        }))} />
      </div>

      <hr class="border-zinc-200/50 dark:border-zinc-800/50" />

      <!-- Work Experience -->
      <div>
        <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-8">
          <Briefcase class="w-6 h-6 text-brand-500" />
          Experience
        </h2>
        <Timeline 
          items={cv.experience.map((job: any) => ({
            title: job.company,
            url: job.url,
            location: job.location,
            dateStart: job.dateStart,
            dateEnd: job.dateEnd,
            hideDuration: job.hideDuration,
            roles: job.roles.map((role: any) => ({
              title: role.title,
              dateStart: role.dateStart,
              dateEnd: role.dateEnd,
              description: role.description,
              hideDuration: role.hideDuration
            }))
          }))} 
        />
      </div>
    </div>
  </section>

  <!-- Achievements Section -->
  <section class="py-12 sm:py-16 border-b border-zinc-200/50 dark:border-zinc-800/50">
    <div class="max-w-3xl">
      <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-8">
        <Award class="w-6 h-6 text-brand-500" />
        Achievements
      </h2>
      <Timeline items={cv.achievements.map((item: any) => ({
        title: item.title,
        subtitle: item.organization,
        url: item.url,
        dateStart: item.date,
        singleDate: true,
        details: item.certificateUrl || "",
        description: item.description,
        hideDuration: item.hideDuration
      }))} />
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-12 sm:py-16 scroll-mt-20">
    <div class="max-w-3xl space-y-8">
      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2">
            <Code class="w-6 h-6 text-brand-500" />
            Projects
          </h2>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2">
            Side projects, open-source packages, and things I've built.
          </p>
        </div>
        
        <!-- Search Input -->
        <div class="relative w-full md:w-72">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-zinc-400 dark:text-zinc-500">
            <Search class="w-4 h-4" />
          </span>
          <input 
            type="text" 
            id="homepage-project-search"
            placeholder="Search projects..." 
            class="w-full pl-9 pr-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500/25 focus:border-brand-500 transition-all duration-150"
          />
        </div>
      </div>

      <!-- Tag Filters -->
      <div class="flex flex-wrap items-center gap-2" id="homepage-tag-filters">
        <button 
          data-filter="featured"
          class="filter-chip active-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-500 text-white border border-transparent transition-all duration-150"
        >
          Featured
        </button>
        <button 
          data-filter="all"
          class="filter-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600 dark:bg-zinc-800/60 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all duration-150"
        >
          All
        </button>
        <button 
          data-filter="android"
          class="filter-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600 dark:bg-zinc-800/60 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all duration-150"
        >
          Android
        </button>
        <button 
          data-filter="web"
          class="filter-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600 dark:bg-zinc-800/60 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all duration-150"
        >
          Web
        </button>
        <button 
          data-filter="other"
          class="filter-chip px-4 py-1.5 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600 dark:bg-zinc-800/60 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50 hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all duration-150"
        >
          Other
        </button>
      </div>

      <!-- Projects Grid -->
      <div 
        class="space-y-6" 
        id="homepage-projects-grid"
      >
        {sortedProjects.map((project) => {
          const titleLower = project.data.title.toLowerCase();
          const summaryLower = project.data.summary.toLowerCase();
          const isFeatured = project.data.featuredProject ? "true" : "false";
          
          // Classify category
          const cleanTags = (project.data.tags || []).map(t => t.toLowerCase());
          let category = 'other';
          if (cleanTags.includes('android')) {
            category = 'android';
          } else if (cleanTags.includes('web') || cleanTags.includes('svelte') || cleanTags.includes('html') || cleanTags.includes('js') || cleanTags.includes('ts')) {
            category = 'web';
          }

          return (
            <div 
              class="homepage-project-card-wrapper transition-all duration-300"
              data-title={titleLower}
              data-summary={summaryLower}
              data-featured={isFeatured}
              data-category={category}
            >
              <Card 
                title={project.data.title.replace(' 🔗', '')}
                description={project.data.summary.replace('|', '').trim()}
                tags={project.data.tags}
                link={project.data.external_link}
                featured={project.data.featured}
                date={project.data.date}
              />
            </div>
          );
        })}
      </div>

      <!-- Empty State -->
      <div id="homepage-empty-state" class="hidden text-center py-12 space-y-3 max-w-md mx-auto">
        <div class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mx-auto text-zinc-400">
          <Code class="w-5 h-5" />
        </div>
        <h3 class="font-bold text-zinc-900 dark:text-zinc-100 text-sm">No projects found</h3>
        <p class="text-xs text-zinc-500 dark:text-zinc-400">
          Try adjusting your search terms or filters.
        </p>
      </div>
    </div>
  </section>

  <!-- Client-side filter script -->
  <script>
    const searchInput = document.getElementById('homepage-project-search') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('#homepage-tag-filters .filter-chip');
    const projectCards = document.querySelectorAll('.homepage-project-card-wrapper');
    const emptyState = document.getElementById('homepage-empty-state');

    let activeFilter = 'featured';
    let searchQuery = '';

    function filterProjects() {
      let visibleCount = 0;

      projectCards.forEach((card) => {
        const el = card as HTMLElement;
        const title = el.dataset.title || '';
        const summary = el.dataset.summary || '';
        const category = el.dataset.category || '';
        const isFeatured = el.dataset.featured === 'true';

        const matchesSearch = title.includes(searchQuery) || summary.includes(searchQuery);
        
        let matchesFilter = false;
        if (activeFilter === 'all') {
          matchesFilter = true;
        } else if (activeFilter === 'featured') {
          matchesFilter = isFeatured;
        } else {
          matchesFilter = category === activeFilter;
        }

        if (matchesSearch && matchesFilter) {
          el.style.display = 'block';
          // Force a tiny reflow for fade in
          setTimeout(() => el.style.opacity = '1', 10);
          visibleCount++;
        } else {
          el.style.opacity = '0';
          el.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    }

    // Set initial display state on load
    filterProjects();

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterProjects();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const button = e.currentTarget as HTMLButtonElement;
        const filter = button.dataset.filter || 'all';

        // Update active chip classes
        filterButtons.forEach(b => {
          b.classList.remove('bg-brand-500', 'text-white', 'active-chip');
          b.classList.add('bg-zinc-100', 'text-zinc-600', 'dark:bg-zinc-800/60', 'dark:text-zinc-300');
        });

        button.classList.add('bg-brand-500', 'text-white', 'active-chip');
        button.classList.remove('bg-zinc-100', 'text-zinc-600', 'dark:bg-zinc-800/60', 'dark:text-zinc-300');

        activeFilter = filter;
        filterProjects();
      });
    });
  </script>
</Layout>
