---
import Layout from '../layouts/Layout.astro';
import Timeline from '../components/Timeline.astro';
import Card from '../components/Card.astro';
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';
import { Mail, FileText, ExternalLink, Award, Sparkles, Code, Briefcase, GraduationCap } from '@lucide/astro';

const cv = yaml.load(fs.readFileSync(path.resolve('src/data/cv.yaml'), 'utf8')) as any;
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

import { parseMarkdown } from '../utils/markdown';
import { getTagStyles } from '../utils/colors';

const parsedBio = parseMarkdown(cv.bio);
---

<Layout>
  <!-- Hero Section -->
  <section class="py-12 md:py-20 flex flex-col-reverse md:flex-row items-center justify-between gap-10 border-b border-zinc-200/50 dark:border-zinc-800/50 transition-colors duration-200">
    <div class="flex-1 text-center md:text-left">
      
      <h1 class="font-display font-extrabold text-4xl sm:text-5xl md:text-6xl tracking-tight text-zinc-900 dark:text-zinc-50 mb-4">
        Hi, I'm <span class="bg-clip-text text-transparent bg-gradient-to-r from-brand-500 to-indigo-500">{cv.name}</span>
      </h1>
      
      <p class="font-display font-medium text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 mb-6">
        {cv.role}
      </p>

      <!-- Contact Icons -->
      <div class="flex flex-wrap justify-center md:justify-start gap-4">
        {cv.email && (
          <a href={`mailto:${cv.email}`} class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200 shadow-sm transition-all duration-200">
            <Mail class="w-4 h-4" />
            Contact Me
          </a>
        )}
        <a href={cv.resumeUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all duration-200">
          <FileText class="w-4 h-4" />
          View Resume
        </a>
      </div>

      <!-- Socials -->
      <div class="flex items-center justify-center md:justify-start gap-4 mt-8 text-zinc-500 dark:text-zinc-400">
        {cv.github && (
          <a href={cv.github} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors" aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          </a>
        )}
        {cv.linkedin && (
          <a href={cv.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors" aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
        )}
      </div>
    </div>

    <!-- Avatar picture -->
    <div class="w-44 h-44 sm:w-56 sm:h-56 relative">
      <div class="relative w-full h-full rounded-full overflow-hidden border-4 border-zinc-200 dark:border-zinc-800 shadow-md">
        <img 
          src={cv.avatar} 
          alt={cv.name} 
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- About Me Section -->
  <section class="py-12 sm:py-16 border-b border-zinc-200/50 dark:border-zinc-800/50 max-w-3xl">
    <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-6">
      <Code class="w-6 h-6 text-brand-500" />
      About Me
    </h2>
    <div class="text-zinc-700 dark:text-zinc-300">
      <div set:html={parsedBio} class="prose prose-zinc dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed" />
      
      <!-- Skills chips list -->
      <div class="mt-8 space-y-4">
        <h3 class="font-bold text-zinc-950 dark:text-zinc-50 text-sm uppercase tracking-wider">
          Technical Arsenal
        </h3>
        <div class="space-y-3">
          {cv.skills.map((group: any) => (
            <div>
              <span class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider block mb-1.5">
                {group.category}
              </span>
              <div class="flex flex-wrap gap-2">
                {group.items.map((skill: string) => (
                  <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold border transition-colors ${getTagStyles(skill)}`}>
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Education & Experience Stacked -->
  <section class="py-12 sm:py-16 border-b border-zinc-200/50 dark:border-zinc-800/50">
    <div class="max-w-3xl space-y-12">
      <!-- Education -->
      <div>
        <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-8">
          <GraduationCap class="w-6 h-6 text-brand-500" />
          Education
        </h2>
        <Timeline items={cv.education.map((edu: any) => ({
          title: edu.course,
          subtitle: edu.institution,
          year: edu.year,
          details: edu.details
        }))} />
      </div>

      <hr class="border-zinc-200/50 dark:border-zinc-800/50" />

      <!-- Work Experience -->
      <div>
        <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-8">
          <Briefcase class="w-6 h-6 text-brand-500" />
          Experience
        </h2>
        <Timeline items={cv.experience.map((job: any) => ({
          title: job.title,
          subtitle: job.company,
          url: job.url,
          location: job.location,
          dateStart: job.dateStart,
          dateEnd: job.dateEnd,
          description: job.description
        }))} />
      </div>
    </div>
  </section>

  <!-- Achievements Section -->
  <section class="py-12 sm:py-16 border-b border-zinc-200/50 dark:border-zinc-800/50">
    <div class="max-w-3xl">
      <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2 mb-8">
        <Award class="w-6 h-6 text-brand-500" />
        Achievements
      </h2>
      <Timeline items={cv.achievements.map((item: any) => ({
        title: item.title,
        subtitle: item.organization,
        url: item.url,
        dateStart: item.date,
        singleDate: true,
        details: item.certificateUrl || "",
        description: item.description
      }))} />
    </div>
  </section>

  <!-- Selected Projects -->
  <section class="py-12 sm:py-16">
    <div class="flex items-center justify-between gap-4 mb-8">
      <h2 class="font-display font-extrabold text-2xl tracking-tight text-zinc-900 dark:text-zinc-50 flex items-center gap-2">
        <Code class="w-6 h-6 text-brand-500" />
        Featured Projects
      </h2>
      <a href="/projects" class="text-sm font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors">
        View All Projects &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sortedProjects.slice(0, 6).map((project) => (
        <Card 
          title={project.data.title.replace(' 🔗', '')}
          description={project.data.summary.replace('|', '').trim()}
          tags={project.data.tags}
          link={project.data.external_link}
          featured={project.data.featured}
          date={project.data.date}
        />
      ))}
    </div>
  </section>
</Layout>
