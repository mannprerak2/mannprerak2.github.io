---
import '../styles/global.css';
import fs from 'fs';
import path from 'path';
import yaml from 'js-yaml';
import { Mail, Sun, Moon, FileText, Menu, X } from '@lucide/astro';

interface Props {
  title?: string;
  description?: string;
  isPrint?: boolean;
}

const cv = yaml.load(fs.readFileSync(path.resolve('src/data/cv.yaml'), 'utf8')) as any;

const { 
  title = cv.title || "Portfolio", 
  description = cv.bio?.substring(0, 160) || "Software Engineer Portfolio",
  isPrint = false 
} = Astro.props;

const gaId = cv.googleAnalyticsId;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts (Inter & Outfit) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Google Analytics -->
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Inline script to prevent FOUC / light-dark flickers -->
    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class={isPrint ? "print-full-width" : ""}>
    {!isPrint && (
      <header class="no-print sticky top-0 z-40 w-full glass border-b border-zinc-200/50 dark:border-zinc-800/50 bg-white/80 dark:bg-zinc-950/80 transition-colors duration-200">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
          <a href="/" class="font-display font-bold text-xl tracking-tight text-zinc-900 dark:text-zinc-50 hover:text-brand-500 transition-colors">
            {cv.name}
          </a>

          <!-- Desktop Navigation -->
          <nav class="hidden md:flex items-center space-x-6">
            <a href="/" class="text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Home</a>
            <a href="/#projects" class="text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Projects</a>
            <a href="/blog" class="text-sm font-medium text-zinc-600 dark:text-zinc-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors">Blog</a>
            <a href={cv.resumeUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 dark:bg-brand-950/50 dark:text-brand-300 border border-brand-200/50 dark:border-brand-800/50 hover:bg-brand-100 dark:hover:bg-brand-900/50 transition-all duration-200">
              <FileText class="w-3.5 h-3.5" />
              Resume
            </a>
            
            <span class="h-4 w-px bg-zinc-200 dark:bg-zinc-800"></span>

            <!-- Theme Toggle -->
            <button id="theme-toggle" class="p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors" aria-label="Toggle theme">
              <Sun class="w-5 h-5 hidden dark:block" />
              <Moon class="w-5 h-5 block dark:hidden" />
            </button>
          </nav>

          <!-- Mobile Nav Toggle -->
          <div class="flex items-center gap-4 md:hidden">
            <button id="theme-toggle-mobile" class="p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors" aria-label="Toggle theme">
              <Sun class="w-5 h-5 hidden dark:block" />
              <Moon class="w-5 h-5 block dark:hidden" />
            </button>
            <button id="mobile-menu-toggle" class="p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors" aria-label="Toggle mobile menu">
              <Menu id="menu-icon" class="w-6 h-6 block" />
              <X id="close-icon" class="w-6 h-6 hidden" />
            </button>
          </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 space-y-2 border-t border-zinc-200/50 dark:border-zinc-800/50 bg-white/95 dark:bg-zinc-950/95 glass">
          <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900">Home</a>
          <a href="/#projects" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900">Projects</a>
          <a href="/blog" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900">Blog</a>
          <a href={cv.resumeUrl} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 rounded-md text-base font-medium text-brand-600 dark:text-brand-400 hover:bg-zinc-100 dark:hover:bg-zinc-900">
            <FileText class="w-5 h-5" />
            Resume
          </a>
        </div>
      </header>
    )}

    <main class={isPrint ? "print-full-width" : "max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12"}>
      <slot />
    </main>

    {!isPrint && (
      <footer class="no-print mt-auto py-8 border-t border-zinc-200/50 dark:border-zinc-800/50 text-zinc-500 dark:text-zinc-400 transition-colors duration-200 bg-zinc-100/50 dark:bg-zinc-900/30">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
          <p class="text-sm">
            &copy; {new Date().getFullYear()} {cv.name}. Built with Astro & Tailwind.
          </p>
          <div class="flex items-center space-x-4">
            {cv.github && (
              <a href={cv.github} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              </a>
            )}
            {cv.linkedin && (
              <a href={cv.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
              </a>
            )}
            {cv.email && (
              <a href={`mailto:${cv.email}`} class="hover:text-brand-500 transition-colors" aria-label="Email">
                <Mail class="w-5 h-5" />
              </a>
            )}
          </div>
        </div>
      </footer>
    )}

    {!isPrint && (
      <script>
        // Desktop Toggle
        const themeToggle = document.getElementById('theme-toggle');
        // Mobile Toggle
        const themeToggleMobile = document.getElementById('theme-toggle-mobile');
        
        const handleToggle = () => {
          const element = document.documentElement;
          element.classList.toggle('dark');
          const isDark = element.classList.contains('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        };

        themeToggle?.addEventListener('click', handleToggle);
        themeToggleMobile?.addEventListener('click', handleToggle);

        // Mobile menu toggle
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        const menuIcon = document.getElementById('menu-icon');
        const closeIcon = document.getElementById('close-icon');

        menuToggle?.addEventListener('click', () => {
          mobileMenu?.classList.toggle('hidden');
          menuIcon?.classList.toggle('hidden');
          closeIcon?.classList.toggle('hidden');
        });
      </script>
    )}
  </body>
</html>
